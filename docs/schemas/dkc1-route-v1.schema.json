{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elliotttate/DKC1Recomp/blob/main/docs/schemas/dkc1-route-v1.schema.json",
  "title": "DKC1 deterministic route recipe",
  "type": "object",
  "required": ["schema", "name", "steps"],
  "properties": {
    "schema": {"const": "dkc1.route.v1"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/input"},
          {"$ref": "#/$defs/wait"},
          {"$ref": "#/$defs/checkpoint"}
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hex6": {"type": "string", "pattern": "^[0-9A-Fa-f]{1,6}$"},
    "hex8": {"type": "string", "pattern": "^[0-9A-Fa-f]{1,8}$"},
    "address": {"type": "string", "pattern": "^[0-1]?[0-9A-Fa-f]{1,4}$"},
    "input": {
      "type": "object",
      "required": ["type", "input", "frames"],
      "properties": {
        "type": {"const": "input"},
        "input": {"$ref": "#/$defs/hex6"},
        "frames": {"type": "integer", "minimum": 1, "maximum": 1000000}
      },
      "additionalProperties": false
    },
    "wait": {
      "type": "object",
      "required": ["type", "address", "op", "value"],
      "properties": {
        "type": {"const": "wait_wram"},
        "address": {"$ref": "#/$defs/address"},
        "width": {"enum": [1, 2, 4]},
        "op": {"enum": ["eq", "ne", "gt", "ge", "lt", "le", "any_set", "all_clear"]},
        "value": {"$ref": "#/$defs/hex8"},
        "mask": {"$ref": "#/$defs/hex8"},
        "shift": {"type": "integer", "minimum": 0, "maximum": 31},
        "signed": {"type": "boolean"},
        "timeout": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "input": {"$ref": "#/$defs/hex6"}
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": {"const": "checkpoint"},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$"}
      },
      "additionalProperties": false
    }
  }
}
